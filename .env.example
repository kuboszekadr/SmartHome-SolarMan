# Example environment variables for Solarman application
# Copy this file to .env and update with your values

# Solarman API Configuration (SOLARMAN_ prefix)
SOLARMAN_APP_ID=your_app_id_here
SOLARMAN_APP_SECRET=your_app_secret_here
SOLARMAN_PASSWORD=your_password_here
SOLARMAN_EMAIL=your_email@example.com
SOLARMAN_INVERTER_SN=your_inverter_serial_number
SOLARMAN_STATION_ID=your_station_id

# Optional: Override default paths
SOLARMAN_WORKING_DIR=/data/solarman
SOLARMAN_CHECKPOINT_FOLDER=checkpoints
SOLARMAN_STORAGE_FOLDER=storage
SOLARMAN_LOGS_FOLDER=logs

# Optional: Override device settings
SOLARMAN_DEVICE_NAME=my_solarman_device
SOLARMAN_ENDPOINT_URL=data-collector.example.com
SOLARMAN_ENDPOINT_PORT=8080

# Home Assistant Configuration (HA_ prefix)
HA_URL=http://homeassistant:8123
HA_TOKEN=your_long_lived_access_token_here

# Optional: Configure upload behavior
HA_UPLOAD_INTERVAL_MINUTES=5
HA_RUN_ONCE=false
HA_SENSOR_PREFIX=solarman
